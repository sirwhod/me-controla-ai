rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members.hasAny([request.auth.uid]);
    }

    function isWorkspaceOwner(workspaceId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.members.hasAll([request.auth.uid]) &&
                       request.resource.data.type in ['personal', 'shared'] &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 2;
      allow update, delete: if isWorkspaceOwner(workspaceId);

      match /{collectionName}/{documentId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }
    }
  }
}
