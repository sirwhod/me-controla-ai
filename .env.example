# ==============================================================================
# MeControla.AI - Variáveis de Ambiente (.env.local)
# ==============================================================================

# NextAuth / Auth.js
# Gere uma chave segura executando no terminal: npx auth secret ou openssl rand -base64 32
AUTH_SECRET="sua_chave_secreta_nextauth_aqui"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Opcional se usar apenas login com Email/Senha)
# Obtenha no Google Cloud Console: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="seu_client_id_google.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu_client_secret_google"

# Firebase Admin SDK (Service Account)
# Obtenha em: Firebase Console > Configurações do Projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID="data-grana"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@data-grana.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET="data-grana.appspot.com"

# Chave independente usada para pseudonimizar IDs nos logs (obrigatória em produção)
# Gere com: openssl rand -base64 32
OBSERVABILITY_HASH_SECRET="sua_chave_aleatoria_de_observabilidade"
